{
  "$schema": "https://schema.tauri.app/config/2",
  "build": {
    "beforeBuildCommand": "npm run build:wdio"
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "capabilities": [
        "default",
        {
          "identifier": "wdio",
          "description": "E2E-only: WebdriverIO plugins (merged in by tauri.wdio.conf.json)",
          "windows": ["main"],
          "permissions": [
            "wdio:default",
            "wdio-webdriver:default",
            "core:window:allow-title",
            "core:window:allow-is-visible"
          ]
        }
      ]
    }
  }
}
