{
  "name": "forgetools",
  "version": "1.0.0",
  "description": "Offline developer utilities in one small desktop app (Tauri)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tengfone/forgetools.git"
  },
  "homepage": "https://github.com/tengfone/forgetools#readme",
  "bugs": {
    "url": "https://github.com/tengfone/forgetools/issues"
  },
  "scripts": {
    "dev": "tauri dev",
    "dev:web": "vite",
    "build": "vite build",
    "tauri": "tauri",
    "preview": "vite preview",
    "start": "npm run dev",
    "test": "npm run test:e2e",
    "test:unit": "vitest run",
    "test:ci": "vitest run && npm run test:e2e",
    "pack": "tauri build --no-bundle",
    "dist": "tauri build",
    "version": "node scripts/sync-version.cjs",
    "release:patch": "npm version patch -m \"chore(release): v%s\" && git push --follow-tags",
    "release:minor": "npm version minor -m \"chore(release): v%s\" && git push --follow-tags",
    "release:major": "npm version major -m \"chore(release): v%s\" && git push --follow-tags",
    "build:wdio": "vite build --mode wdio",
    "build:e2e": "node scripts/build-e2e.cjs",
    "test:e2e": "npm run build:e2e && npm run test:e2e:run",
    "test:e2e:run": "wdio run wdio.conf.mjs",
    "test:smoke": "node scripts/smoke-release.cjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.test.json",
    "lint:gate": "node scripts/grep-gate.cjs",
    "report:size": "node scripts/report-size.cjs",
    "demo": "wdio run scripts/demo.wdio.conf.mjs"
  },
  "keywords": [
    "developer-tools",
    "utilities",
    "offline-tools",
    "code-formatter",
    "qr-code",
    "jwt",
    "crypto",
    "base64",
    "markdown",
    "yaml",
    "json",
    "code-editor",
    "monaco-editor",
    "tauri"
  ],
  "author": "tengfone",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@tauri-apps/cli": "^2.12.4",
    "@types/js-beautify": "^1.14.3",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.6.6",
    "@types/papaparse": "^5.5.2",
    "@types/qrcode": "^1.5.6",
    "@wdio/cli": "^9.32.0",
    "@wdio/local-runner": "^9.32.0",
    "@wdio/mocha-framework": "^9.32.0",
    "@wdio/spec-reporter": "^9.32.0",
    "@wdio/tauri-plugin": "^1.5.1",
    "@wdio/tauri-service": "^1.5.1",
    "autoprefixer": "^10.4.16",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "postcss": "^8.4.32",
    "prettier": "^3.1.1",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.3.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^6.4.5",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-clipboard-manager": "^2.5.0",
    "@tauri-apps/plugin-opener": "^2.7.2",
    "@tauri-apps/plugin-os": "^2.4.0",
    "@xmldom/xmldom": "^0.8.15",
    "cron-parser": "^5.10.2",
    "diff": "^9.0.0",
    "dompurify": "^3.4.17",
    "graphql": "~17.0.2",
    "hash-wasm": "^4.12.0",
    "html-to-jsx-transform": "^1.2.1",
    "js-beautify": "^1.15.4",
    "js-yaml": "^4.3.2",
    "jsbarcode": "^3.12.1",
    "marked": "^18.1.2",
    "monaco-editor": "^0.57.0",
    "papaparse": "^5.7.0",
    "qrcode": "^1.5.3",
    "smol-toml": "^1.9.1",
    "svgo": "^3.2.0",
    "terser": "^5.51.2",
    "ulid": "^2.4.0"
  },
  "overrides": {
    "postcss-selector-parser": "^7.1.6",
    "dompurify": "$dompurify"
  }
}
