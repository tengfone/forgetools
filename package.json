{
  "name": "forgetools",
  "version": "0.2.1",
  "description": "Offline Developer Utilities",
  "scripts": {
    "dev": "tauri dev",
    "dev:web": "vite",
    "build": "vite build",
    "tauri": "tauri",
    "preview": "vite preview",
    "start": "npm run dev",
    "test": "playwright test",
    "test:unit": "vitest run",
    "test:ui": "playwright test --ui",
    "test:ci": "vitest run && playwright test --reporter=list,html",
    "pack": "tauri build --no-bundle",
    "dist": "tauri build",
    "postinstall": "node scripts/setup-monaco.js",
    "version": "node scripts/sync-version.cjs",
    "release:patch": "npm version patch -m \"chore(release): v%s\" && git push --follow-tags",
    "release:minor": "npm version minor -m \"chore(release): v%s\" && git push --follow-tags",
    "release:major": "npm version major -m \"chore(release): v%s\" && git push --follow-tags"
  },
  "keywords": [
    "developer-tools",
    "utilities",
    "offline-tools",
    "code-formatter",
    "qr-code",
    "jwt",
    "crypto",
    "base64",
    "markdown",
    "yaml",
    "json",
    "code-editor",
    "monaco-editor",
    "tauri"
  ],
  "author": "tengfone",
  "license": "MIT",
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@playwright/test": "^1.49.1",
    "@tauri-apps/cli": "^2.12.4",
    "@types/diff": "^5.2.3",
    "@types/fs-extra": "^11.0.4",
    "@types/js-beautify": "^1.14.3",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^24.19.2",
    "@types/papaparse": "^5.5.2",
    "@types/qrcode": "^1.5.6",
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "@typescript-eslint/parser": "^8.72.0",
    "autoprefixer": "^10.4.16",
    "cron-parser": "^4.9.0",
    "diff": "^5.2.2",
    "dompurify": "^3.4.17",
    "eslint": "^8.56.0",
    "fs-extra": "^11.3.2",
    "graphql": "~17.0.2",
    "hash-wasm": "^4.12.0",
    "html-to-jsx-transform": "^1.2.1",
    "js-beautify": "^1.15.4",
    "js-yaml": "^4.3.2",
    "marked": "^11.2.0",
    "material-icons": "^1.13.14",
    "monaco-editor": "^0.45.0",
    "papaparse": "^5.7.0",
    "postcss": "^8.4.32",
    "prettier": "^3.1.1",
    "smol-toml": "^1.9.1",
    "tailwindcss": "^3.4.0",
    "terser": "^5.44.1",
    "typescript": "^5.3.3",
    "ulid": "^2.4.0",
    "vite": "^6.4.5",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.4",
    "@xmldom/xmldom": "^0.8.15",
    "jsbarcode": "^3.12.1",
    "qrcode": "^1.5.3",
    "svgo": "^3.2.0"
  },
  "overrides": {
    "postcss-selector-parser": "^7.1.6"
  }
}
