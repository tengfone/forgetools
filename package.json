{
  "name": "forgetools",
  "version": "0.1.0",
  "description": "Offline Developer Utilities",
  "main": "out/main/main.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "start": "npm run dev",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:ci": "playwright test --reporter=list,html",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder",
    "postinstall": "node scripts/setup-monaco.js",
    "release:patch": "npm version patch -m \"chore(release): v%s\" && git push --follow-tags",
    "release:minor": "npm version minor -m \"chore(release): v%s\" && git push --follow-tags",
    "release:major": "npm version major -m \"chore(release): v%s\" && git push --follow-tags"
  },
  "keywords": [
    "developer-tools",
    "electron-app",
    "utilities",
    "offline-tools",
    "code-formatter",
    "qr-code",
    "jwt",
    "crypto",
    "base64",
    "markdown",
    "yaml",
    "json",
    "code-editor",
    "monaco-editor"
  ],
  "author": "tengfone",
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.49.1",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^20.10.0",
    "@types/qrcode": "^1.5.6",
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "@typescript-eslint/parser": "^8.72.0",
    "autoprefixer": "^10.4.16",
    "electron": "^44.9.3",
    "electron-builder": "^26.18.0",
    "electron-vite": "^3.1.0",
    "eslint": "^8.56.0",
    "fs-extra": "^11.3.2",
    "postcss": "^8.4.32",
    "prettier": "^3.1.1",
    "tailwindcss": "^3.4.0",
    "terser": "^5.44.1",
    "typescript": "^5.3.3",
    "vite": "^6.4.5"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@xmldom/xmldom": "^0.8.15",
    "cron-parser": "^4.9.0",
    "diff": "^5.1.0",
    "dompurify": "^3.4.17",
    "html-to-jsx-transform": "^1.2.1",
    "js-beautify": "^1.14.11",
    "js-yaml": "^4.1.1",
    "jsbarcode": "^3.12.1",
    "marked": "^11.1.0",
    "material-icons": "^1.13.14",
    "monaco-editor": "^0.45.0",
    "papaparse": "^5.4.1",
    "qrcode": "^1.5.3",
    "svgo": "^3.2.0",
    "ulid": "^2.3.0"
  },
  "build": {
    "appId": "com.forgetools.app",
    "productName": "ForgeTools",
    "asar": true,
    "compression": "maximum",
    "removePackageScripts": true,
    "removePackageKeywords": true,
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "out/**/*",
      "src/renderer/fonts/**/*",
      "src/renderer/assets/**/*",
      "package.json",
      "!**/node_modules/*/{test,__tests__,tests,powered-test,example,examples}",
      "!**/*.map",
      "!**/*.md",
      "!**/*.ts",
      "!src/**/*.ts",
      "!**/tsconfig.json",
      "!**/jsconfig.json",
      "!electron.vite.config.ts",
      "!**/node_modules/**/*.d.ts",
      "!**/node_modules/**/README*",
      "!**/node_modules/**/CHANGELOG*",
      "**/node_modules/**/{LICENSE,LICENCE,COPYING,NOTICE}*"
    ],
    "extraResources": [
      {
        "from": "build/icon256.png",
        "to": "tray.png"
      }
    ],
    "extraFiles": [],
    "npmRebuild": false,
    "nodeGypRebuild": false,
    "buildDependenciesFromSource": false,
    "asarUnpack": [
      "node_modules/qrcode/**/*",
      "node_modules/jsbarcode/**/*",
      "node_modules/@xmldom/xmldom/**/*"
    ],
    "afterPack": "./build/afterPack.js",
    "mac": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "artifactName": "ForgeTools-${version}-mac-${arch}.${ext}",
      "category": "public.app-category.developer-tools",
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "entitlements": null,
      "entitlementsInherit": null,
      "provisioningProfile": null
    },
    "win": {
      "target": "portable",
      "icon": "build/icon.ico"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "ForgeTools-${version}.${ext}",
      "category": "Development",
      "icon": "build/icon512.png"
    },
    "portable": {
      "artifactName": "ForgeTools-Portable-${version}.exe",
      "requestExecutionLevel": "user"
    }
  },
  "overrides": {
    "postcss-selector-parser": "^7.1.6"
  }
}
